{
	"name": "scan-moodle-rs",
	"image": "mcr.microsoft.com/devcontainers/rust:2.0.13-1-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/git:1.3.7": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"vadimcn.vscode-lldb",
				"fill-labs.dependi",
				"anthropic.claude-code",
				"robinreiche.csv-grid-editor"
			],
			"settings": {
				"editor.formatOnSave": true,
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer"
				},
				"rust-analyzer.check.command": "clippy"
			}
		}
	},
	"postCreateCommand": "rustc --version && cargo --version",
	"remoteUser": "vscode"
}